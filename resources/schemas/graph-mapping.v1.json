{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Customs declaration graph mapping proposals",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "items",
    "results",
    "documentRecords",
    "dtsFacts",
    "referenceSelections",
    "catalogRequests",
    "contextRequests",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": "graph-mapping-v1" },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemKey", "description", "evidence"],
        "properties": {
          "itemKey": { "type": "string", "minLength": 1, "maxLength": 80 },
          "description": { "type": ["string", "null"], "maxLength": 4000 },
          "evidence": { "$ref": "#/$defs/evidenceList" }
        }
      }
    },
    "results": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["graphId", "itemKey", "status", "values", "positionValue", "searchedSourceIds", "reason"],
        "properties": {
          "graphId": { "type": "string" },
          "itemKey": { "type": ["string", "null"], "maxLength": 80 },
          "status": { "enum": ["found", "conflict", "not_found", "incomplete"] },
          "values": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/bindingValue" } },
          "positionValue": { "$ref": "#/$defs/positionValue" },
          "searchedSourceIds": { "$ref": "#/$defs/sourceIdList" },
          "reason": { "type": ["string", "null"], "maxLength": 500 }
        }
      }
    },
    "documentRecords": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recordKey", "itemKeys", "values"],
        "properties": {
          "recordKey": { "type": "string", "minLength": 1, "maxLength": 80 },
          "itemKeys": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 80 } },
          "values": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/bindingValue" } }
        }
      }
    },
    "dtsFacts": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["matrixId", "itemKey", "value"],
        "properties": {
          "matrixId": { "type": "string", "minLength": 1, "maxLength": 40 },
          "itemKey": { "type": ["string", "null"], "maxLength": 80 },
          "value": { "$ref": "#/$defs/bindingValue" }
        }
      }
    },
    "referenceSelections": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["graphId", "itemKey", "fieldId", "catalogId", "candidateId", "rationale", "evidence"],
        "properties": {
          "graphId": { "type": "string" },
          "itemKey": { "type": ["string", "null"], "maxLength": 80 },
          "fieldId": { "type": "string" },
          "catalogId": { "type": "string", "minLength": 1, "maxLength": 80 },
          "candidateId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 500 },
          "evidence": { "$ref": "#/$defs/evidenceList" }
        }
      }
    },
    "catalogRequests": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["graphId", "itemKey", "fieldId", "query", "reason"],
        "properties": {
          "graphId": { "type": "string" },
          "itemKey": { "type": ["string", "null"], "maxLength": 80 },
          "fieldId": { "type": "string" },
          "query": { "type": "string", "minLength": 1, "maxLength": 500 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "contextRequests": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["graphId", "itemKey", "sourceIds", "reason"],
        "properties": {
          "graphId": { "type": "string" },
          "itemKey": { "type": ["string", "null"], "maxLength": 80 },
          "sourceIds": { "$ref": "#/$defs/sourceIdList" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "warnings": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 500 } }
  },
  "$defs": {
    "sourceIdList": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "type": "string", "pattern": "^src_[a-f0-9]{32}$" } },
    "evidenceList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "quote"],
        "properties": {
          "sourceId": { "type": "string", "pattern": "^src_[a-f0-9]{32}$" },
          "quote": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "bindingValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldId", "valueType", "rawValue", "normalizedValue", "unit", "currency", "evidence"],
      "properties": {
        "fieldId": { "type": "string" },
        "valueType": { "type": "string" },
        "rawValue": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "normalizedValue": {
          "anyOf": [
            { "type": "string", "maxLength": 4000 },
            { "type": "number" },
            { "type": "integer" },
            { "type": "boolean" },
            { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 500 } }
          ]
        },
        "unit": { "type": ["string", "null"], "maxLength": 40 },
        "currency": { "type": ["string", "null"], "maxLength": 8 },
        "evidence": { "$ref": "#/$defs/evidenceList" }
      }
    },
    "positionValue": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["valueType", "rawValue", "normalizedValue", "evidence"],
      "properties": {
        "valueType": { "type": "string" },
        "rawValue": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "normalizedValue": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "evidence": { "$ref": "#/$defs/evidenceList" }
      }
    }
  }
}
