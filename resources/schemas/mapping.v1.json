{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Customs document field proposals",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entities",
    "candidates",
    "warnings"
  ],
  "properties": {
    "entities": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "scope",
          "role",
          "source"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "scope": {
            "type": "string",
            "enum": [
              "party",
              "goods",
              "document",
              "transport",
              "cost"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "seller",
              "buyer",
              "consignor",
              "consignee",
              "declarant",
              "financial",
              "arrival",
              "border",
              null
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "documentId",
              "page",
              "blockId",
              "sheet",
              "cell",
              "quote"
            ],
            "properties": {
              "documentId": {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              },
              "page": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "blockId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sheet": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cell": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$"
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fieldId",
          "entityKey",
          "rawValue",
          "unit",
          "source"
        ],
        "properties": {
          "fieldId": {
            "type": "string"
          },
          "entityKey": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "rawValue": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "documentId",
              "page",
              "blockId",
              "sheet",
              "cell",
              "quote"
            ],
            "properties": {
              "documentId": {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              },
              "page": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "blockId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sheet": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "cell": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$"
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    }
  }
}
