      "parameters": [
        "feeBase",
        "feeAdditional"
      ],
      "allocation": "equal-with-deterministic-rounding-remainder"
    },
    {
      "code": "2010",
      "kind": "tariff-expression",
      "expression": "advalorem | specific | max | sum | min(percent, max(percent, specific))",
      "source": "Подтверждённая пользователем ставка по коду/происхождению/дате",
      "parameters": [
        "dutyRate",
        "dutySpecificRate",
        "dutyCurrency",
        "dutyPerQuantity",
        "dutyQuantity",
        "dutyAlternativeRate"
      ]
    },
    {
      "code": "5060",
      "kind": "vat",
      "expression": "(customsValue + duty + fee) * vatRate / 100",
      "source": "design.md:D7; включение сбора — явно предварительный профиль примеров",
      "parameters": [
        "vatRate"
      ],
      "requiresConfirmedBasis": true
    }
  ],
  "exchangeRatePolicy": {
    "dateField": "declaration.signatureDate",
    "quote": "KZT per nominal units",
    "formula": "amount * value / nominal",
    "requireFor": [
      "invoiceCurrency",
      "USD",
      "costCurrencies",
      "specificDutyCurrency"
