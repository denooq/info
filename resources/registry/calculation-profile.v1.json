    "preserveNominal": true,
    "manualOverrideRequiresBasis": true,
    "autoConfirmedOfficialRate": true
  },
  "method1Formula": "basisKzt + additionsKzt - deductionsKzt",
  "statisticalFormula": "(basisOnBorderKzt + statisticalAddition - statisticalDeduction) / usdKztPerUnit",
  "paymentFacts": {
    "deriveFromAccrual": false,
    "sourceRequired": true,
    "roundingSource": "reference/rules/DT_2026.docx:15(46)"
  },
  "unsupported": [
