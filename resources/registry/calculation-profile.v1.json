  },
  "rounding": {
    "mode": "HALF_UP",
    "moneyScale": 2,
    "statisticalScale": 2,
    "massScale": 3,
    "subGramMassScale": 6,
    "paymentFactScale": 0,
    "source": "reference/rules/DT_2026.docx:15(11),(33),(36),(40),(43)-(46)"
  },
  "formulas": [
    {
      "code": "1010",
      "kind": "fee",
      "expression": "(feeBase + extraSheets * feeAdditional) / goodsCount",
